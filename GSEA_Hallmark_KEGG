# Function to save fgsea results
save_fgsea_results <- function(fgsea_result, filename) {
  
  # Convert to data frame
  df <- as.data.frame(fgsea_result)
  
  # Convert leadingEdge list to comma-separated string
  df$leadingEdge <- sapply(df$leadingEdge, function(x) {
    paste(x, collapse = ", ")
  })
  
  # Save CSV
  write.csv(df, filename, row.names = FALSE)
  cat("✓ Saved:", filename, "\n")
}

