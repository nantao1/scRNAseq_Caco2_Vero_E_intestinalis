#Create a ranked list function
create_ranked_list <- function(markers, cluster_id) {
  
  # Filter for cluster
  cluster_data <- markers[markers$cluster == cluster_id, ]
  
  # Create named vector: names = genes, values = log2FC
  gene_ranks <- setNames(cluster_data$avg_log2FC, cluster_data$gene)
  
  # Handle duplicates (keep gene with highest absolute log2FC)
  if(any(duplicated(names(gene_ranks)))) {
    gene_ranks <- tapply(gene_ranks, names(gene_ranks), function(x) x[which.max(abs(x))])
  }
  
  # Sort descending (most upregulated first, most downregulated last)
  gene_ranks <- sort(gene_ranks, decreasing = TRUE)
  
  # Print summary
  cat("\n", cluster_id, "ranked gene list:\n")
  cat("  Total genes:", length(gene_ranks), "\n")
  cat("  Upregulated (>0):", sum(gene_ranks > 0), "\n")
  cat("  Downregulated (<0):", sum(gene_ranks < 0), "\n")
  cat("  Top 3:", head(names(gene_ranks), 3), "\n")
  cat("  Bottom 3:", tail(names(gene_ranks), 3), "\n")
  
  return(gene_ranks)
}

# fGSEA function
run_fgsea_analysis <- function(gene_ranks, gene_sets, min_size = 15, max_size = 500) {
  
  # Run fgsea
  fgsea_results <- fgsea(
    pathways = gene_sets,
    stats = gene_ranks,
    minSize = min_size,
    maxSize = max_size
  )
  
  # Add direction column based on NES
  fgsea_results$direction <- ifelse(
    fgsea_results$NES > 0, 
    "Activated", 
    "Suppressed"
  )
  
  # Sort by p-value
  fgsea_results <- fgsea_results[order(pval), ]
  
  # Print summary
  n_sig <- sum(fgsea_results$padj < 0.05, na.rm = TRUE)
  n_activated <- sum(fgsea_results$padj < 0.05 & fgsea_results$NES > 0, na.rm = TRUE)
  n_suppressed <- sum(fgsea_results$padj < 0.05 & fgsea_results$NES < 0, na.rm = TRUE)
  
  cat("  Significant pathways (padj < 0.05):", n_sig, "\n")
  cat("    Activated:", n_activated, "\n")
  cat("    Suppressed:", n_suppressed, "\n")
  
  return(fgsea_results)
}

