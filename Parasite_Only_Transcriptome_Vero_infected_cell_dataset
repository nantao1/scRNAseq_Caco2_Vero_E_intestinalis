table(gene.hashtag$HTO_classification.global)
#Doublet= 3158 Negative= 235  Single= 24723  
# subset singlet
gene.hashtag<- subset(gene.hashtag, idents = c("Vero-12hpi", "Vero-18hpi", "Vero-24hpi", "Vero-36hpi","Vero-42hpi", "Vero-ctrl"))
dim(gene.hashtag)
# 21176 24723

#separate out microsporidia transcripts
# subset microsporidia transcripts = 19166-21176
Expt1_MicrosporidiaOnly <- subset(gene.hashtag[19166:21176,])

# normalize data 
Expt1_MicrosporidiaOnly <- NormalizeData(Expt1_MicrosporidiaOnly)
Expt1_MicrosporidiaOnly <- FindVariableFeatures(Expt1_MicrosporidiaOnly, selection.method = "vst", nfeatures = 3000)
# using just the highly variable features to scale data
Expt1_MicrosporidiaOnly <- ScaleData(Expt1_MicrosporidiaOnly)
dim(Expt1_MicrosporidiaOnly)
# 2011 24723

# import information from the 0.2% microsporidia cut off in NVASC041
NVASC041_infected_cell_barcodes_and_clusters_0.2 <- read_csv("NVASC041_infected_cell_barcodes_and_clusters_0.2.csv")

#subset the 0.2% microsporidia transcripts
NVASC041_infected_cell_barcodes_and_clusters <- subset(NVASC041_infected_cell_barcodes_and_clusters_0.2, subset = percent.microsporidia > 0.2)

# Subset only infected cells that contain more than 0.2% of microsporidian transcripts from NVASC041. By doing this, we don't have to perform filtering out
cell.use <- NVASC041_infected_cell_barcodes_and_clusters$...1
Expt1_MicrosporidiaOnly <- subset(Expt1_MicrosporidiaOnly, cells = cell.use)
dim(Expt1_MicrosporidiaOnly)
# 2011 11192 

# Add the cluster information from NVASC041. Remember to grab the column from the subsetted object that has >0.2 percent microsporidia transcripts
NVASC041_clusters <- NVASC041_infected_cell_barcodes_and_clusters$renamed_idents
Expt1_MicrosporidiaOnly <- AddMetaData(Expt1_MicrosporidiaOnly, metadata = NVASC041_clusters, col.name = "NVASC041_clusters")

remove(raw.data)
remove(gene.hashtag)
remove(percent.mt)
remove(raw.gene.count)
remove(raw.HTO.count)
