remove(percent.microsporidia)

# Run PCA and find which PCs to include
Expt1_MicrosporidiaOnly <- RunPCA(Expt1_MicrosporidiaOnly)
percent.pc <- Expt1_MicrosporidiaOnly@reductions$pca@stdev / sum(Expt1_MicrosporidiaOnly@reductions$pca@stdev) * 100
cum.percent.pc <- cumsum(percent.pc)
cum.percent.pc
ElbowPlot(Expt1_MicrosporidiaOnly)
# Find neighbours and clusters
set.seed(2025)
Expt1_MicrosporidiaOnly <- FindNeighbors(Expt1_MicrosporidiaOnly, dims = 1:43)
Expt1_MicrosporidiaOnly <- FindClusters(Expt1_MicrosporidiaOnly, resolution = c(0.2, 0.25, 0.3, 0.4))
# Run UMAP
Expt1_MicrosporidiaOnly  <- RunUMAP(Expt1_MicrosporidiaOnly , dims = 1:43)
