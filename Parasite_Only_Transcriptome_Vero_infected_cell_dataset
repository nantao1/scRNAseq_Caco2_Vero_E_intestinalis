head(gene.hashtag, n=10)
# Adding HTO information before
gene.hashtag[["HTO"]] <- CreateAssayObject(counts = raw.HTO.count)
gene.hashtag <- NormalizeData(gene.hashtag, assay = "HTO", normalization.method = "CLR")
