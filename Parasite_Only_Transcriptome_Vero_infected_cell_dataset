p3 <- DimPlot(Expt1_MicrosporidiaOnly, group.by = "RNA_snn_res.0.3", label = TRUE, cols = "Paired") + ggtitle("Resolution 0.3")
p4 <- DimPlot(Expt1_MicrosporidiaOnly, group.by = "RNA_snn_res.0.4", label = TRUE, cols = "Paired") + ggtitle("Resolution 0.4")
