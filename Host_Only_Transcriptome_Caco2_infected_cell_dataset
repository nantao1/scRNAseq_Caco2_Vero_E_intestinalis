# number of infected cells across time points and clusters with a 2% microsporidia cut off
infected_timepointsANDclusters_1 <- table(Expt1_HumanOnly@meta.data$HTO_maxID, Expt1_HumanOnly$renamed_idents, Expt1_HumanOnly@meta.data$infected_cell_1)
infected_timepointsANDclusters_1 <- as.data.frame(infected_timepointsANDclusters_1)
colnames(infected_timepointsANDclusters_1) <- c("Condition", "Cluster", "infected_cell_1", "Cell_Count")
write.csv(infected_timepointsANDclusters_1, file = "no_infected_cells_1.csv", row.names = FALSE)

